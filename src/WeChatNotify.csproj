<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>WeChatNotify</AssemblyName><RootNamespace>WeChatNotifier</RootNamespace>
    <Version>0.2.0-rc.1</Version><AssemblyVersion>0.2.0.0</AssemblyVersion>
    <RepositoryUrl>https://github.com/CanstaSolance/wechat-notification-helper</RepositoryUrl>
    <Product>微信提醒助手（独立工具）</Product><ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>微信提醒助手</AssemblyTitle>
    <ApplicationIcon>Assets/helper.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <Deterministic>true</Deterministic><DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild><PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" /><EmbeddedResource Include="Assets/helper.png" /></ItemGroup>
</Project>
