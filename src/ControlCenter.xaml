<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <Grid.Resources>
  <Style TargetType="Button"><Setter Property="FocusVisualStyle"><Setter.Value><Style TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="Box" Width="17" Height="17" CornerRadius="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Visibility="Collapsed" Data="M 3,8 L 7,12 L 14,4" Stroke="{DynamicResource OnAccent}" StrokeThickness="2"/></Border><ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropButton" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" CornerRadius="8" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><ContentPresenter Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center"/><Path Grid.Column="1" Data="M 2,5 L 6,9 L 10,5" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Border x:Name="FocusRing" IsHitTestVisible="False" CornerRadius="9" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Margin="-2" Visibility="Collapsed"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,2,0,0"><ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" KeyboardNavigation.DirectionalNavigation="Contained"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" CornerRadius="6" Background="Transparent"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Tint}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Tint}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="20,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
  <TextBlock x:Name="Brand" Tag="微信提醒助手" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,24,0"/>
  <Grid Grid.Column="1" Width="276" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Button x:Name="Nav0" Tag="提醒" Padding="6,8" BorderThickness="0" Background="Transparent" Margin="0,4,0,6" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Button x:Name="Nav1" Tag="设置" Padding="6,8" Grid.Column="1" BorderThickness="0" Background="Transparent" Margin="0,4,0,6" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Button x:Name="Nav2" Tag="帮助" Padding="6,8" Grid.Column="2" BorderThickness="0" Background="Transparent" Margin="0,4,0,6" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <Border x:Name="Marker" Height="2" Width="72" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.ColumnSpan="3"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
  </Grid>
  <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Minimize" FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE921;" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><Button x:Name="Maximize" FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE922;" Grid.Column="1" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><Button x:Name="CloseWindow" FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE8BB;" Grid.Column="2" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True"/></Grid>
 </Grid>
 <Grid x:Name="Viewport" Grid.Row="1" Margin="24,12,24,0">
  <ScrollViewer x:Name="Page0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}"><Grid x:Name="StatusGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="SampleColumn" Width="210"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="StatusTitle" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="StatusNote" Style="{StaticResource Note}"/><WrapPanel Margin="0,12,0,0"><Button x:Name="Test" Tag="发送测试通知" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="{DynamicResource Accent}"/><Button x:Name="Pause" Tag="暂停提醒"/></WrapPanel></StackPanel><Border x:Name="Sample" Grid.Column="1" Background="{DynamicResource Tint}" Padding="16" CornerRadius="10" VerticalAlignment="Center"><StackPanel><TextBlock Tag="通知示意" Style="{StaticResource Note}"/><TextBlock Tag="微信有新提醒" FontWeight="SemiBold"/><TextBlock Tag="消息正文已隐藏" Style="{StaticResource Note}" Margin="0"/></StackPanel></Border></Grid></Border>
   <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Tag="系统提醒" FontWeight="SemiBold"/><TextBlock Tag="消息正文不会显示在通知里。" Style="{StaticResource Note}"/></StackPanel><TextBlock x:Name="Badge" Grid.Column="1" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/></Grid><Border Height="1" Background="{DynamicResource Line}" Margin="0,8,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Tag="点击通知打开微信" FontWeight="SemiBold"/><TextBlock Tag="可选，使用微信现有的快捷键。" Style="{StaticResource Note}"/></StackPanel><Button x:Name="SetupShortcut" Grid.Column="1" Tag="去设置" VerticalAlignment="Center"/></Grid></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <ScrollViewer x:Name="Page1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel><DockPanel><CheckBox x:Name="Enabled" DockPanel.Dock="Right" Tag="开启"/><StackPanel><TextBlock Tag="系统提醒" FontWeight="SemiBold"/><TextBlock Tag="收到微信提醒时，显示系统通知。" Style="{StaticResource Note}"/></StackPanel></DockPanel><Border Height="1" Background="{DynamicResource Line}" Margin="0,8,0,16"/><DockPanel><CheckBox x:Name="Startup" DockPanel.Dock="Right" Tag="开启"/><StackPanel><TextBlock Tag="随电脑登录启动" FontWeight="SemiBold"/><TextBlock Tag="不用每次手动开启助手。" Style="{StaticResource Note}"/></StackPanel></DockPanel><Border Height="1" Background="{DynamicResource Line}" Margin="0,8,0,16"/><DockPanel><ComboBox x:Name="Language" DockPanel.Dock="Right" Width="140" VerticalAlignment="Center"><ComboBoxItem Content="中文"/><ComboBoxItem Content="English"/></ComboBox><TextBlock Text="Language / 语言" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Tag="点击通知打开微信（可选）" Style="{StaticResource Heading}"/><TextBlock Tag="录入或选字母，再核对微信里的实际设置。" Style="{StaticResource Note}"/><WrapPanel Margin="0,8,0,8"><Button x:Name="Recorder" MinWidth="180"/><Button x:Name="ClearShortcut" Tag="清除"/><Button x:Name="DeferShortcut" Tag="稍后设置"/></WrapPanel><WrapPanel Margin="0,4,0,4"><TextBlock Tag="从按键中选择：Ctrl + Alt +" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="Letters" Width="80"/></WrapPanel><CheckBox x:Name="Confirmed" Tag="与微信现有的“显示/隐藏窗口”快捷键一致"/><CheckBox x:Name="PauseShortcut" Tag="暂停点击打开"/><TextBlock Tag="微信 → 设置 → 快捷键 → 显示/隐藏窗口。找不到或不确定时，清除快捷键，先使用提醒即可。" Style="{StaticResource Note}"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><Expander x:Name="PathExpander" Tag="微信安装位置"><StackPanel><TextBox x:Name="SelectedPath" IsReadOnly="True" Margin="0,8,0,12"/><WrapPanel><Button x:Name="Browse" Tag="选择微信程序"/><Button x:Name="AutoPath" Tag="自动识别"/></WrapPanel></StackPanel></Expander></Border>
   <Border x:Name="ConsentCard" Style="{StaticResource Card}"><StackPanel><TextBlock Tag="首次启用" Style="{StaticResource Heading}"/><TextBlock Tag="提醒可能合并或遗漏，不显示姓名和正文。助手不会替你启动或登录微信。完整说明见帮助。" Style="{StaticResource Note}"/><CheckBox x:Name="Consent" Tag="我已了解并同意启用助手"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
  <ScrollViewer x:Name="Page2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Tag="使用与隐私" Style="{StaticResource Heading}"/><TextBlock Tag="通知只显示“微信有新提醒”，不含姓名、正文，也不会直达某个聊天。连续提醒可能合并，部分消息可能没有提示。"/><TextBlock Tag="没有看到通知？先发送测试通知，再检查 Windows 通知中心、勿扰和通知权限。微信在前台时可能不再弹出提醒。"/><TextBlock Tag="助手不读取聊天、联系人或登录凭据。设置、程序路径、快捷键确认和有限运行记录仅保存在本机；没有自有上传或遥测服务。"/><WrapPanel Margin="0,8,0,0"><Button x:Name="PrivacyLink" Tag="在线隐私说明 ↗"/><Button x:Name="GuideLink" Tag="在线使用帮助 ↗"/></WrapPanel></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Tag="版本与排查" Style="{StaticResource Heading}"/><TextBlock Text="v0.3.0 · ui-polish.20261103.2" Style="{StaticResource Note}"/><TextBlock Tag="通知与打开行为只在一台 Windows 11 x64、微信 4.1.15.56 上验证。其他官方版本属于实验性支持。" Style="{StaticResource Note}"/><Expander x:Name="DetailsExpander" Tag="查看详细信息"><TextBox x:Name="Details" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Tag="管理助手" Style="{StaticResource Heading}"/><TextBlock Tag="关闭窗口后仍会提醒。要完全停止，请退出助手。" Style="{StaticResource Note}"/><WrapPanel><Button x:Name="Quit" Tag="退出助手"/><Button x:Name="Uninstall" Tag="卸载助手"/></WrapPanel></StackPanel></Border>
  </StackPanel></ScrollViewer>
 </Grid>
 <Grid Grid.Row="2" Margin="24,12,24,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="Footer" Style="{StaticResource Note}" Margin="0"/><TextBlock x:Name="Feedback" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel><StackPanel x:Name="SaveBar" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed"><Button x:Name="Save" Tag="保存更改" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="{DynamicResource Accent}"/><Button x:Name="Cancel" Tag="撤销"/></StackPanel></Grid>
</Grid>
